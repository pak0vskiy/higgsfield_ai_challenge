# LLM extraction — OpenRouter (primary)
# Get your key at https://openrouter.ai/keys
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEY=your_openrouter_key_here

# Fallback: OpenAI (used if OpenRouter fails)
OPENAI_API_KEY=your_openai_key_here

# Optional: require bearer token auth on all endpoints except /health
MEMORY_AUTH_TOKEN=

# Data directory (inside container — do not change unless mounting elsewhere)
DATA_DIR=/data
