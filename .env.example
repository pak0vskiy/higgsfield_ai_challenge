# ── LLM extraction — OpenRouter (primary) ─────────────────────────────────────
# Get your key at https://openrouter.ai/keys
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEY=your_openrouter_key_here

# ── LLM fallback + embeddings — OpenAI ────────────────────────────────────────
# Used as LLM fallback if OpenRouter fails.
# Also used for semantic embeddings (text-embedding-3-small) to power dense retrieval.
# Without this key, the service falls back to BM25-only recall (still functional).
OPENAI_API_KEY=your_openai_key_here

# ── Embeddings configuration ──────────────────────────────────────────────────
# Provider: "openai" (default, needs OPENAI_API_KEY) or "fake" (offline tests only)
EMBEDDINGS_PROVIDER=openai
# Model used for vector embeddings (text-embedding-3-small = 1536-dim)
EMBEDDING_MODEL=text-embedding-3-small
# Dimension is auto-set based on provider (openai=1536, fake=64).
# Only set this if you switch to a different embedding model.
# EMBEDDING_DIM=1536

# ── Entity deduplication ──────────────────────────────────────────────────────
# Fuzzy similarity threshold for entity-key merging (0-100, token_set_ratio).
# Values >= this are treated as the same entity. Default 88 avoids false merges.
ENTITY_FUZZY_THRESHOLD=88

# ── Auth (optional) ───────────────────────────────────────────────────────────
# Set to require Bearer token on all endpoints except /health.
# Leave empty to disable auth.
MEMORY_AUTH_TOKEN=

# ── Internal ──────────────────────────────────────────────────────────────────
# Data directory (inside container — do not change unless mounting elsewhere)
DATA_DIR=/data
